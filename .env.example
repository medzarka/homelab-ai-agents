# ==============================================================================
# Homelab AI Agents Stack Configuration (Hermes Agent + Mem0 Memory)
# Optimized for ARM64 (Orange Pi 5 Plus 32GB RAM / Linux)
# ==============================================================================

# --- 1. Base Storage Directory ---
# Base path on the host for workspaces, databases, and logs
DATA_DIR=/srv/data/ai-agents

# Timezone (e.g. UTC, Europe/Paris, Africa/Tunis, America/New_York)
TZ=UTC

# --- 2. Hermes Agent Gateway & Dashboard ---
# API server authentication key for client access
HERMES_API_SERVER_KEY=generate_a_secure_hermes_api_key

# Dashboard basic auth credentials
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change_this_to_a_secure_dashboard_password
HERMES_DASHBOARD_BASIC_AUTH_SECRET=generate_a_32_byte_hex_secret

# Git integration for automated code editing / pushing
GITHUB_TOKEN=your_github_personal_access_token_here

# User/Group IDs inside the container
HERMES_UID=1000
HERMES_GID=1000

# --- 3. LiteLLM / Model Providers Integration ---
# LiteLLM Proxy or OpenAI-compatible backend URL and Master Key
LITELLM_API_BASE=http://100.83.191.68:4000/v1
LITELLM_MASTER_KEY=your_litellm_master_key_here

# Default Agent & Vision Models
LLM_MODEL=hermes-default
VLM_MODEL=hermes-vision
EMBEDDING_MODEL=BAAI/bge-m3

# Optional Infinity Embeddings Server
INFINITY_API_BASE=http://100.83.191.70:9999/v1
INFINITY_API_KEY=your_infinity_key_here

# --- 4. Web Search, Extraction, & RAG Tools ---
# SearXNG Web Search
SEARXNG_BASE_URL=http://100.83.191.70:8080

# Firecrawl Web Scraper
FIRECRAWL_API_URL=http://100.83.191.70:3038
FIRECRAWL_API_KEY=your_firecrawl_key_here

# Docling Document Converter
DOCLING_API_URL=http://100.83.191.70:5501/v1/convert/file

# Qdrant Vector Database
QDRANT_URL=http://100.83.191.68:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# --- 5. Mem0 Conversational Memory (PostgreSQL + Neo4j) ---
# PostgreSQL credentials (pgvector)
MEM0_PG_USER=postgres
MEM0_PG_PASSWORD=generate_a_secure_postgres_password
MEM0_PG_DB=mem0

# Neo4j Graph Database credentials (minimum 8 chars)
NEO4J_PASSWORD=generate_a_secure_neo4j_password

# --- 6. Network Configuration ---
SHARED_NETWORK=shared_net
