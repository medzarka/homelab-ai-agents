# ==============================================================================
# Homelab AI Agents Stack Configuration (.env.example)
# Services: Hermes Agent (Gateway & Dashboard), Workspace Scanner & Open-WebUI
# Fully integrated with Homelab Microservices (Ollama, TEI, Speaches, Mem0, Qdrant, Sandbox)
# ==============================================================================

# --- 1. Cluster & Domain Configuration ---
ROOT_DOMAIN=bluewave.work
DATA_DIR=/srv/data/ai-agents
TZ=UTC
SHARED_NETWORK=shared_net
SWARM_NETWORK=homelab_swarm_net

# --- 2. Hermes Agent Gateway & Dashboard ---
HERMES_GATEWAY_PORT=8642
HERMES_DASHBOARD_PORT=9119
HERMES_BRIDGE_PORT=3000
HERMES_UID=1000
HERMES_GID=1000

# Authentication Keys
HERMES_API_SERVER_KEY=change_this_to_a_secure_hermes_api_key
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change_this_to_a_secure_dashboard_password
HERMES_DASHBOARD_BASIC_AUTH_SECRET=change_this_to_a_random_32_byte_hex_secret
HERMES_DASHBOARD_PUBLIC_URL=https://hermes.example.com
GITHUB_TOKEN=your_github_token_here

# --- 3. LiteLLM & Model Gateway ---
LITELLM_API_BASE=http://litellm:4000/v1
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_MASTER_KEY=your_litellm_master_key_here
LITELLM_API_KEY=your_litellm_master_key_here
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_API_KEY=your_ollama_master_key_here
LLM_MODEL=hermes-default
VLM_MODEL=hermes-vision

# --- 4. TEI Embeddings & Reranker ---
EMBEDDINGS_API_BASE=http://embeddings:80/v1
RERANKER_API_BASE=http://reranker:80
TEI_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# --- 5. Web Search & Extraction ---
SEARXNG_BASE_URL=http://searxng:8080
FIRECRAWL_API_URL=http://firecrawl-api:3036
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# --- 6. Conversational Memory & Knowledge Base ---
MEM0_API_URL=http://mem0-api:8000
MEM0_API_KEY=dummy-local-key
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=workspace

# --- 7. Model Context Protocol (MCP) Services ---
KNOWLEDGE_MCP_URL=http://knowledge-mcp:8095/mcp/sse
KNOWLEDGE_MCP_HTTP_URL=http://knowledge-mcp:8095
KNOWLEDGE_MCP_API_KEY=your_knowledge_mcp_api_key_here
SANDBOX_MCP_URL=http://agent-sandbox:8088/mcp/sse
SANDBOX_API_KEY=your_sandbox_api_key_here

# --- 8. Speech Audio (Faster-Whisper & Kokoro TTS) ---
WHISPER_LANGUAGE=
SPEACHES_BASE_URL=http://speaches:8000/v1
SPEACHES_API_KEY=
WHISPER_MODEL=Systran/faster-whisper-medium
KOKORO_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
KOKORO_VOICE=af_heart

# --- 9. Workspace Incremental Scanner ---
SCAN_INTERVAL_SECONDS=900

# --- 10. Open-WebUI Chat Interface ---
OPEN_WEBUI_PORT=3030
WEBUI_NAME=Bluewave AI Hub
WEBUI_BRAND=Bluewave AI Hub
WEBUI_SECRET_KEY=change_this_to_a_secure_webui_secret_key
WEBUI_WORKERS=4
